# ── Maʼlumotlar bazasi (Supabase → Settings → Database) ──
# Pooled (pgbouncer) ulanish — ilova uchun
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Toʻgʻridan-toʻgʻri ulanish — migratsiyalar uchun
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# ── Auth ──
NEXTAUTH_URL="http://localhost:3000"
# openssl rand -base64 48
NEXTAUTH_SECRET="change-me"
APP_URL="http://localhost:3000"
# Login sahifasida demo hisoblar tugmalarini ko'rsatish (lokal ishlab chiqish uchun)
NEXT_PUBLIC_SHOW_DEMO_CREDS="1"

# ── Supabase Realtime (ixtiyoriy — navbat tablosi uchun; boʻlmasa SSE ishlatiladi) ──
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# ── Email (parolni tiklash) — boʻlmasa dev rejimida konsolga chiqadi ──
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="LOR CRM <noreply@lor.uz>"

# ── SMS (Eskiz.uz) ──
ESKIZ_EMAIL=""
ESKIZ_PASSWORD=""
ESKIZ_FROM="4546"
# Ixtiyoriy — boʻsh boʻlsa https://notify.eskiz.uz/api ishlatiladi
ESKIZ_BASE_URL=""

# ── Telegram bot ──
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ADMIN_CHAT_ID=""

# ── Toʻlov tizimlari (keyingi bosqich) ──
CLICK_MERCHANT_ID=""
CLICK_SERVICE_ID=""
CLICK_SECRET_KEY=""
# Click kabinetidagi "Merchant user ID" — toʻlov havolasini yigʻishda ishlatiladi
CLICK_MERCHANT_USER_ID=""
PAYME_MERCHANT_ID=""
PAYME_KEY=""
# Sandbox kaliti — berilsa test soʻrovlari ham qabul qilinadi
PAYME_TEST_KEY=""
# Ixtiyoriy — boʻsh boʻlsa https://checkout.paycom.uz ishlatiladi
PAYME_CHECKOUT_URL=""

# ── Cron himoyasi (Vercel Cron → Authorization: Bearer) ──
CRON_SECRET="change-me"
